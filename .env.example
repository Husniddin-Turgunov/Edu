# Akela EDU — shablon: faqat kalitlar (qiymatlar endi Infisical'da)
# Lokal ishlash: infisical run --env=dev -- npm run dev
# Maxfiy qiymatlarni hech qachon Git'ga, chatga yoki faylga yozmang.

# --- Majburiy ---
# MySQL ulanish: ichki db xizmati uchun bo'sh qoldiring (compose default ishlatadi)
DATABASE_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=
# Sayt manzili: https://edu.akelagroup.uz (lokal uchun http://localhost:3000)
NEXTAUTH_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- OsnovaEDU integratsiyasi ---
OSNOVAEDU_BASE_URL=
OSNOVAEDU_ORG_ID=
OSNOVAEDU_EMAIL=
OSNOVAEDU_PASSWORD=
OSNOVAEDU_ONBOARDING_COURSE_ID=

# --- Docker (ichki db xizmati uchun, DATABASE_URL bo'sh bo'lsa) ---
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Infisical (CI/CD, Docker, serverlar uchun; lokal dev'da kerak emas) ---
# infisical login / infisical init haqida: INFISICAL.md
INFISICAL_PROJECT_ID=
# Ishlatiladigan muhit slug'i: dev | staging | prod
INFISICAL_ENV=
# Machine identity (Universal Auth) — faqat CI/CD va Docker'da
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# Self-hosted / EU Cloud bo'lsa: https://eu.infisical.com
INFISICAL_DOMAIN=

# --- Docker boshqaruvi ---
# DB sinxronizatsiyasi: push (default, yangi va mavjud DB uchun) | migrate | skip
DB_SYNC=push
# Kontenerdagi port -> server porti
PORT=3000
